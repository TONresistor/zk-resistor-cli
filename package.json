{
  "name": "zkresistor-cli",
  "version": "2.0.1",
  "description": "Command-line interface for ZKResistor, a trustless ZK privacy pool on TON. Wallet, deposits, withdraws, pool creation.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "zkr": "./dist/index.js"
  },
  "files": [
    "dist",
    "artifacts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --clean --no-dts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@orbs-network/ton-access": "^2.3.3",
    "@ton/core": "^0.63.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "@tonresistor/zkresistor-sdk": "2.0.1",
    "citty": "^0.1.6",
    "picocolors": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "execa": "^9.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ton",
    "zk",
    "zero-knowledge",
    "privacy",
    "mixer",
    "cli",
    "wallet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TONresistor/zk-resistor-cli.git"
  },
  "bugs": {
    "url": "https://github.com/TONresistor/zk-resistor-cli/issues"
  },
  "homepage": "https://zk.resistance.dog",
  "overrides": {
    "axios": "1.18.1",
    "bfj": "9.1.3",
    "form-data": "4.0.6",
    "hono": "4.12.28",
    "tar": "7.5.19"
  }
}
